---
import Icon from './Icon.astro';
import { stats } from '../data/site';
---
<section class="wrap">
  <div class="grid grid-cols-2 gap-6 rounded-2xl border border-brand/10 bg-cream p-6 md:grid-cols-4 md:p-8">
    {stats.map((s) => (
      <div class="flex items-center gap-3">
        <Icon name={s.icon} class="h-8 w-8 shrink-0 text-brand" />
        <div>
          <div class="text-2xl font-semibold">{s.value}</div>
          <div class="text-sm text-gray-500">{s.label}</div>
        </div>
      </div>
    ))}
  </div>
</section>
