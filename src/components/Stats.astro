---
import Icon from './Icon.astro';
import { stats } from '../data/site';
---
<section class="wrap my-8 md:my-12">
  <div class="grid grid-cols-2 gap-6 rounded-[18px] border border-[#FFE5CC] bg-[#FFF9F2] p-6 md:grid-cols-4 md:p-8">
    {stats.map((s) => (
      <div class="flex items-center gap-3.5">
        <Icon name={s.icon} class="h-10 w-10 shrink-0 text-[#FE7E01]" />
        <div>
          <div class="text-2xl font-extrabold text-black sm:text-4xl tracking-tight mb-2">{s.value}</div>
          <div class="text-xs sm:text-base text-[#6D6B69] font-normal">{s.label}</div>
        </div>
      </div>
    ))}
  </div>
</section>
