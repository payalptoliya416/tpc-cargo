---
import Icon from './Icon.astro';
import { stats } from '../data/site';
---
<section class="wrap my-8 md:my-12">
  <div class="grid grid-cols-2 gap-6 rounded-2xl border border-[#FE7E01]/15 bg-[#FFF9F3] p-6 md:grid-cols-4 md:p-8">
    {stats.map((s) => (
      <div class="flex items-center gap-3.5">
        <Icon name={s.icon} class="h-9 w-9 shrink-0 text-[#FE7E01]" />
        <div>
          <div class="text-2xl font-bold text-black sm:text-3xl tracking-tight">{s.value}</div>
          <div class="text-xs sm:text-sm text-[#858482] font-normal">{s.label}</div>
        </div>
      </div>
    ))}
  </div>
</section>
