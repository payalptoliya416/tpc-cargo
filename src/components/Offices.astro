---
import Icon from './Icon.astro';
import { offices } from '../data/site';
---
<section class="wrap pt-2 md:pt-6 pb-10 md:pb-[120px] !px-0">
  <div class="grid gap-5 md:gap-8 md:grid-cols-3 md:divide-x md:divide-gray-200/80">
    {offices.map((o, idx) => (
      <div class="space-y-4">
        <h4 class="text-xl font-semibold text-[#FE7E01] border-l-2 border-brand pl-2.5"> {o.country}</h4>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs sm:text-base text-[#3C3A38] font-medium">
          <span class="flex items-center gap-1.5"><Icon name="pin" class="h-4 w-4 text-dark shrink-0" />{o.address}</span>
          <span class="text-gray-300 hidden sm:inline">|</span>
          <span class="flex items-center gap-1.5"><Icon name="phone" class="h-4 w-4 text-dark shrink-0" />{o.phone}</span>
        </div>
        <div class="flex items-center gap-1.5 text-xs sm:text-sm text-[#3C3A38] font-medium">
          <Icon name="mail" class="h-4 w-4 text-dark shrink-0" />{o.email}
        </div>
      </div>
    ))}
  </div>
</section>
