---
import QuoteForm from './QuoteForm.astro';
import { highlight } from '../utils';
const { badge, title, text, image, formTitle } = Astro.props;
---
<!-- the quote card hangs a bit below the hero on desktop, like the design -->
<section class="relative px-3 md:px-6 lg:h-[760px] lg:flex lg:items-center lg:mb-24">
  <div class="absolute inset-y-0 inset-x-3 overflow-hidden rounded-3xl bg-dark bg-cover bg-center md:inset-x-6" style={`background-image:url('${image}')`}>
    <!-- <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-black/35"></div> -->
  </div>
  <div class="wrap relative grid gap-8 py-10 text-white md:py-14 lg:grid-cols-2 lg:py-0 w-full lg:items-center z-10">
    <div class="lg:self-center">
      <!-- Clickable Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-xs sm:text-sm text-gray-300">
        <a href="/" class="transition hover:text-[#FE7E01] hover:underline underline-offset-4">TPC Cargo</a>
        <span class="text-gray-400">›</span>
        <a href="/services" class="transition hover:text-[#FE7E01] hover:underline underline-offset-4">Services</a>
        <span class="text-gray-400">›</span>
        <span class="font-medium text-white">{badge || 'Service'}</span>
      </nav>

      <span class="badge">{badge}</span>
      <h1 class="mt-4 text-3xl font-medium leading-tight sm:text-4xl md:text-5xl lg:text-[56px] xl:text-[68px] text-white" set:html={highlight(title)} />
      <p class="mt-4 max-w-lg text-sm sm:text-base lg:text-lg leading-relaxed text-[#B6B5B4]">{text}</p>
      
      <!-- Review Badges -->
      <div class="mt-8 flex flex-wrap gap-4">
        <!-- Google Review -->
        <div class="flex items-center gap-3 rounded-[12px] border border-white/30 bg-[#FFFFFF26] px-5 py-3 backdrop-blur-md">
          <svg viewBox="0 0 24 24" class="h-9 w-9 shrink-0" fill="none">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <div>
            <div class="text-base font-semibold text-white leading-tight mb-0.5">Google</div>
            <div class="text-sm text-white">4.9 <span class="text-[#FFC107] font-bold ml-1">★ ★ ★ ★ ★</span></div>
          </div>
        </div>

        <!-- Facebook Review -->
        <div class="flex items-center gap-3 rounded-[12px] border border-white/30 bg-[#FFFFFF26] px-5 py-3 backdrop-blur-md">
          <svg viewBox="0 0 24 24" class="h-9 w-9 shrink-0" fill="#1877F2">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <div>
            <div class="text-base font-semibold text-white leading-tight mb-0.5">Facebook</div>
            <div class="text-sm text-white">5.0 <span class="text-[#FFC107] font-bold ml-1">★ ★ ★ ★ ★</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="lg:-mb-24 lg:self-center lg:justify-self-end lg:w-full lg:max-w-[560px]"><QuoteForm title={formTitle} /></div>
  </div>
</section>
