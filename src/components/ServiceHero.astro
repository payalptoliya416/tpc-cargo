---
import QuoteForm from './QuoteForm.astro';
import { highlight } from '../utils';
const { badge, title, text, image, formTitle } = Astro.props;
---
<section class="px-2 md:px-4">
  <div class="relative overflow-hidden rounded-3xl bg-dark bg-cover bg-center" style={`background-image:url('${image}')`}>
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="wrap relative grid items-center gap-8 py-12 text-white lg:grid-cols-2 lg:py-16">
      <div>
        <span class="badge !bg-black/30">{badge}</span>
        <h1 class="mt-5 text-4xl font-medium leading-tight md:text-5xl" set:html={highlight(title)} />
        <p class="mt-5 max-w-md text-sm leading-6 text-gray-300">{text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <div class="rounded-xl border border-white/20 bg-black/30 px-4 py-2 text-sm"><b>Google</b><br /><span class="text-xs">4.9 <span class="text-brand">★★★★★</span></span></div>
          <div class="rounded-xl border border-white/20 bg-black/30 px-4 py-2 text-sm"><b>Facebook</b><br /><span class="text-xs">5.0 <span class="text-brand">★★★★★</span></span></div>
        </div>
      </div>
      <QuoteForm title={formTitle} />
    </div>
  </div>
</section>
