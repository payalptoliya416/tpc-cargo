---
import QuoteForm from './QuoteForm.astro';
import Icon from './Icon.astro';
import { highlight } from '../utils';
const { badge, title, text, image, formTitle, googleUrl = 'https://google.com', facebookUrl = 'https://facebook.com' } = Astro.props;
---
<!-- the quote card hangs a bit below the hero on desktop, like the design -->
<section class="relative px-3 md:px-6 lg:h-[760px] lg:flex lg:items-start lg:mb-24">
  <div class="absolute inset-y-0 inset-x-3 overflow-hidden rounded-3xl bg-dark bg-cover bg-center md:inset-x-6" style={`background-image:url('${image}')`}>
    <!-- <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-black/35"></div> -->
  </div>
  <div class="wrap relative grid gap-8 py-10 text-white md:py-14 lg:grid-cols-2 lg:pt-[130px] lg:pb-0 w-full lg:items-start z-10">
    <div class="lg:self-start">

      <span class="badge-dark">{badge}</span>
      <h1 class="mt-4 text-3xl font-medium leading-tight sm:text-4xl md:text-5xl lg:text-[56px] xl:text-[68px] text-white" set:html={highlight(title)} />
      <p class="mt-4 max-w-lg text-sm sm:text-base lg:text-lg leading-relaxed text-[#B6B5B4]">{text}</p>
      
      <!-- Review Badges -->
      <div class="mt-8 flex flex-wrap gap-2 sm:gap-4 font-[Inter,sans-serif]">
        <!-- Google Review -->
        <a
          href={googleUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-[12px] border border-white/30 bg-[#FFFFFF26] px-3 md:px-5 py-2 sm:py-3 backdrop-blur-md transition hover:bg-white/35 hover:scale-[1.02] cursor-pointer"
        >
          <img src="/images/google.svg" alt="Google" class="h-6 sm:h-9 w-6 sm:w-9 shrink-0" />
          <div>
            <div class="text-base text-white leading-tight mb-0.5">Google</div>
            <div class="text-sm text-white flex items-center gap-1">4.9 <span class="flex ml-1 text-[#FFC107]">{[1,2,3,4,5].map(() => <Icon name="star" class="h-3.5 w-3.5" />)}</span></div>
          </div>
        </a>

        <!-- Facebook Review -->
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-[12px] border border-white/30 bg-[#FFFFFF26] px-3 md:px-5 py-2 sm:py-3 backdrop-blur-md transition hover:bg-white/35 hover:scale-[1.02] cursor-pointer"
        >
          <img src="/images/facebook.svg" alt="Facebook" class="h-6 sm:h-9 w-6 sm:w-9 shrink-0" />
          <div>
            <div class="text-base text-white leading-tight mb-0.5">Facebook</div>
            <div class="text-sm text-white flex items-center gap-1">5.0 <span class="flex ml-1 text-[#FFC107]">{[1,2,3,4,5].map(() => <Icon name="star" class="h-3.5 w-3.5" />)}</span></div>
          </div>
        </a>
      </div>
    </div>
    <div class="lg:self-start lg:justify-self-end lg:w-full lg:max-w-[560px] lg:-mb-28"><QuoteForm title={formTitle} /></div>
  </div>
</section>
