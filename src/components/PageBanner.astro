---
// Top banner for About / Services / Contacts
const { title } = Astro.props;
---
<section class="px-3 md:px-6">
  <div class="relative flex min-h-[260px] items-center justify-center overflow-hidden rounded-3xl bg-dark bg-cover bg-center md:min-h-[360px]" style="background-image:url('/images/sea-freight-sol.jpg')">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative text-center text-white">
      <span class="badge !bg-black/30">TPC Cargo</span>
      <h1 class="mt-4 text-4xl font-medium md:text-6xl">{title}</h1>
      <p class="mt-3 text-sm text-gray-200">TPC Cargo &nbsp;›&nbsp; {title}</p>
    </div>
  </div>
</section>
