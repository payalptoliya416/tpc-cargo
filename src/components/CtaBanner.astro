---
import { highlight } from '../utils';

interface Props {
  badge?: string;
  title?: string | any;
  text?: string;
  button?: string;
  href?: string;
  image?: string;
}

const {
  badge,
  title,
  text,
  button = 'Contact Now',
  href = '/contacts',
  image = '/images/road-freight-sol.png'
} = Astro.props;
---
<section class="relative bg-dark bg-cover bg-center text-center text-white" style={`background-image:url('${image}')`}>
  <!-- <div class="absolute inset-0 bg-black/60"></div> -->
  <div class="wrap relative py-16 md:py-28 z-10">
    {badge && <span class="badge !bg-black/40">{badge}</span>}
    <h2 class="mt-4 text-3xl font-medium md:text-4xl" set:html={highlight(title)} />
    {text && <p class="mx-auto mt-4 max-w-2xl text-sm text-gray-300">{text}</p>}
    <a href={href} class="btn mt-8">{button}</a>
  </div>
</section>
