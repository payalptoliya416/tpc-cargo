---
// Quote form shown inside the service hero
const { title = 'Get Your Quote' } = Astro.props;
---
<div class="rounded-[20px] bg-white p-4 sm:p-10 text-dark shadow-[0_6px_80px_0_rgba(0,0,0,0.08)] border border-[#F3F3F3]">
  <h3 class="text-xl sm:text-2xl font-bold text-dark">{title}</h3>
  <p class="mt-[15px] text-xs sm:text-base text-[#858482]">Tell us about your shipment and our team will get back to you with the right shipping solution.</p>
  
  <form action="#" class="mt-6 grid gap-5 sm:grid-cols-2 font-[Inter,sans-serif]">
    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-user.svg" alt="" class="" />
        <span>First name</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Your first name" required />
    </div>

    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-user.svg" alt="" class="" />
        <span>Last name</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Your last name" required />
    </div>

    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-mail.svg" alt="" class="" />
        <span>Email</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input type="email" class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="you@company.com" required />
    </div>

    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-call.svg" alt="" class="" />
        <span>Phone Number</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input type="tel" class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="+00 | You phone number" required />
    </div>

    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-location.svg" alt="" class="" />
        <span>From (Origin)</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Port or City, Country" required />
    </div>

    <div>
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-location.svg" alt="" class="" />
        <span>To (Destination)</span>
        <span class="text-[#ED0E0E]">*</span>
      </label>
      <input class="mt-[10px] w-full rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-4 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Port or City, Country" required />
    </div>

    <div class="sm:col-span-2">
      <label class="flex items-center gap-1.5 text-sm text-[#3C3A38]">
        <img src="/images/form-msj.svg" alt="" class="" />
        <span>Additional Details</span>
      </label>
      <textarea rows="3" class="mt-[10px] w-full min-h-[90px] max-h-[150px] resize-y overflow-y-auto rounded-lg border border-[#E7E6E6] bg-white px-[15px] py-3 text-sm text-[#3C3A38] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Tell us about your cargo, quantity, dimensions or any special requirements..."></textarea>
    </div>

    <div class="pt-[5px] text-center sm:col-span-2">
      <button class="sm:min-w-[240px] rounded-full bg-brand px-5 sm:px-8 py-3 sm:py-4 text-sm font-semibold uppercase tracking-wider text-black shadow-lg transition-all duration-300 hover:brightness-110 hover:shadow-xl hover:scale-[1.02] cursor-pointer">
        GET MY FREE QUOTE
      </button>
    </div>
  </form>
</div>
