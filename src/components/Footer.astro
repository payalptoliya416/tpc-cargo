---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navLinks, phone, email, hours } from '../data/site';
import { services } from '../data/services';

// Footer shows these 5 services only
const footerServices = services.filter((s) => ['sea-freight', 'air-freight', 'road-freight', 'cargo-insurance', 'parcel-courier'].includes(s.slug));

const path = Astro.url.pathname;
// Note: isActive used as SSR fallback; client-side JS handles static builds
const isActive = (href: string) => path === href;
---
<footer class="bg-dark text-gray-300">
  <div class="wrap grid gap-5 md:gap-10 py-10 sm:py-14 sm:grid-cols-2 lg:grid-cols-4 font-[Inter,sans-serif]">
    <div>
      <Logo footer />
      <p class="mt-5 max-w-xs text-base leading-6 text-white">Everyday is a new day for us and we work really hard to satisfy our customer everywhere.</p>
    </div>
    <div class="lg:pl-10">
      <h4 class="mb-4 font-medium uppercase text-white">Useful Links</h4>
      <ul class="space-y-4 text-base text-[#9D9C9B]">
        {navLinks.map((l) => (
          <li>
            <a
              href={l.href}
              data-footer-link={l.href}
              class="footer-link"
            >
              {l.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="mb-4 font-medium uppercase text-white">Get in Touch</h4>
      <ul class="space-y-4 text-base text-[#9D9C9B]">
        <li>
          <a
            href="https://maps.google.com/?q=Iapetou+21,+Agios+Athanasios"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link inline-flex items-center gap-2"
          >
            <img src="/images/footer-location.svg" alt="" class="h-4 w-4 shrink-0" />
            <span>Iapetou 21, Agios Athanasios</span>
          </a>
        </li>
        <li>
          <a
            href={`tel:${phone.replace(/\s+/g, '')}`}
            class="footer-link inline-flex items-center gap-2"
          >
            <img src="/images/footer-call.svg" alt="" class="h-4 w-4 shrink-0" />
            <span>+357 25 254 515</span>
          </a>
        </li>
        <li>
          <a
            href={`mailto:${email}`}
            class="footer-link inline-flex items-center gap-2"
          >
            <img src="/images/footer-email.svg" alt="" class="h-4 w-4 shrink-0" />
            <span>{email}</span>
          </a>
        </li>
        <li class="flex items-center gap-2">
          <img src="/images/footer-clock.svg" alt="" class="h-4 w-4 shrink-0" />
          <span>{hours}</span>
        </li>
      </ul>
    </div>
    <div>
      <h4 class="mb-4 font-medium uppercase text-white">Our Services</h4>
      <ul class="space-y-4 text-base text-[#9D9C9B]">
        {footerServices.map((s) => (
          <li>
            <a
              href={`/services/${s.slug}`}
              data-footer-link={`/services/${s.slug}`}
              class="footer-link"
            >
              {s.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-col items-center justify-between gap-4 border-t border-white/10 py-6 text-base sm:flex-row">
    <p class="text-white text-center sm:text-left">Copyright © {new Date().getFullYear()} TPCCARGO. All rights reserved.</p>
    <div class="flex gap-5">
      <a href="#" aria-label="Facebook" class="social-icon flex h-10 sm:h-[46px] w-10 sm:w-[46px] items-center justify-center rounded-full border border-white/20">
        <img src="/images/footer-facebook.svg" alt="Facebook" class="" />
      </a>
      <a href="#" aria-label="Meta" class="social-icon flex h-10 sm:h-[46px] w-10 sm:w-[46px] items-center justify-center rounded-full border border-white/20">
        <img src="/images/footer-meta.svg" alt="Meta" class="" />
      </a>
      <a href="#" aria-label="Instagram" class="social-icon flex h-10 sm:h-[46px] w-10 sm:w-[46px] items-center justify-center rounded-full border border-white/20">
        <img src="/images/footer-insta.svg" alt="Instagram" class="" />
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var current = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('[data-footer-link]').forEach(function (el) {
      var href = el.getAttribute('data-footer-link').replace(/\/$/, '') || '/';
      if (href === current) {
        el.classList.add('footer-link--active');
      }
    });
  })();
</script>
