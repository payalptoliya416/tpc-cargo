---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navLinks, phone, email, hours } from '../data/site';
import { services } from '../data/services';

// Footer shows these 5 services only
const footerServices = services.filter((s) => ['sea-freight', 'air-freight', 'road-freight', 'cargo-insurance', 'parcel-courier'].includes(s.slug));
---
<footer class="bg-dark text-gray-300">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo footer />
      <p class="mt-5 max-w-xs text-sm leading-6 text-white">Everyday is a new day for us and we work really hard to satisfy our customer everywhere.</p>
    </div>
    <div>
      <h4 class="mb-4 font-semibold uppercase text-white">Useful Links</h4>
      <ul class="space-y-3 text-sm">
        {navLinks.map((l) => <li><a href={l.href} class="hover:text-[#FE7E01]">{l.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h4 class="mb-4 font-semibold uppercase text-white">Get in Touch</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4" />Iapetou 21, Agios Athanasios</li>
        <li class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4" />+357 25 254 515</li>
        <li class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4" />{email}</li>
        <li class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4" />{hours}</li>
      </ul>
    </div>
    <div>
      <h4 class="mb-4 font-semibold uppercase text-white">Our Services</h4>
      <ul class="space-y-3 text-sm">
        {footerServices.map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-[#FE7E01]">{s.name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap flex flex-col items-center justify-between gap-4 border-t border-white/10 py-6 text-sm sm:flex-row">
    <p class="text-white">Copyright © 2023 TPCCARGO. All rights reserved.</p>
    <div class="flex gap-3">
      {['facebook', 'x', 'instagram'].map((n) => (
        <a href="#" aria-label={n} class="flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-white hover:border-brand hover:text-[#FE7E01]"><Icon name={n} class="h-4 w-4" /></a>
      ))}
    </div>
  </div>
</footer>
