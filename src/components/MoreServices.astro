---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';
// shows 3 other services (the ones after the current one)
const { current } = Astro.props;
const i = services.findIndex((s) => s.slug === current);
const others = [1, 2, 3].map((n) => services[(i + n) % services.length]);
---
<section class="section">
  <div class="wrap">
    <div class="grid gap-4 md:grid-cols-2 md:items-end">
      <SectionHeading badge="Explore our logistics services" title="More Ways To Move [Your Cargo]" />
      <p class="text-muted">Explore our complementary logistics services designed to support your shipment from origin to final destination with reliable, flexible solutions.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((s) => <ServiceCard service={s} />)}
    </div>
  </div>
</section>
