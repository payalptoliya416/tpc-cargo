---
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';

const { current } = Astro.props;
const list = current ? services.filter((s) => s.slug !== current) : services;
---
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<section class="section relative overflow-hidden sm:overflow-visible">
  <div class="wrap space-y-10">
    <!-- Header Row: Badge & Title Left, Subtitle Right -->
    <div class="grid gap-6 lg:grid-cols-2 md:items-center md:gap-14">
      <SectionHeading badge="Explore our logistics services" title="More Ways To Move [Your Cargo]" />
      <p class="text-muted">
        Explore our complementary logistics services designed to support your shipment from origin to final destination with reliable, flexible solutions.
      </p>
    </div>

    <!-- Swiper Slider Container with Responsive Arrow Buttons -->
    <div class="relative w-full">
      <!-- Left Arrow Button -->
      <button
        id="more-prev"
        aria-label="Previous service"
        class="flex h-10 sm:h-[46px] w-10 sm:w-[46px] sm:h-[50px] sm:w-[50px] rounded-full border border-[#CECECD] bg-white/90 backdrop-blur-sm items-center justify-center text-[#0B0806] hover:border-brand hover:text-white hover:bg-brand transition shadow-lg cursor-pointer shrink-0 z-30 absolute left-2 sm:left-3 2xl:-left-16 top-[40%] sm:top-1/2 -translate-y-1/2"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <!-- Swiper Main Track -->
      <div class="swiper more-services-swiper w-full overflow-hidden">
        <div class="swiper-wrapper py-2 items-stretch">
          {list.map((s) => (
            <div class="swiper-slide !h-auto flex">
              <div class="w-full flex">
                <ServiceCard service={s} />
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Arrow Button -->
      <button
        id="more-next"
        aria-label="Next service"
        class="flex h-10 sm:h-[46px] w-10 sm:w-[46px] sm:h-[50px] sm:w-[50px] rounded-full border border-[#CECECD] bg-white/90 backdrop-blur-sm items-center justify-center text-[#0B0806] hover:bg-brand hover:text-white transition shadow-lg cursor-pointer shrink-0 z-30 absolute right-2 sm:right-3 2xl:-right-16 top-[40%] sm:top-1/2  -translate-y-1/2"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script is:inline>
    function initMoreServicesSwiper() {
      if (typeof Swiper !== 'undefined') {
        new Swiper('.more-services-swiper', {
          slidesPerView: 1,
          spaceBetween: 24,
          slidesPerGroup: 1,
          loop: true,
          speed: 600,
          grabCursor: true,
          navigation: {
            nextEl: '#more-next',
            prevEl: '#more-prev',
          },
          breakpoints: {
            640: {
              slidesPerView: 2,
              slidesPerGroup: 1,
              spaceBetween: 24,
            },
            1024: {
              slidesPerView: 3,
              slidesPerGroup: 1,
              spaceBetween: 24,
            },
          },
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMoreServicesSwiper);
    } else {
      initMoreServicesSwiper();
    }
  </script>
</section>

<style>
  .more-services-swiper .swiper-wrapper {
    display: flex !important;
    align-items: stretch !important;
  }
  .more-services-swiper .swiper-slide {
    height: auto !important;
    display: flex !important;
  }
</style>
