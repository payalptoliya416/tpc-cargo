---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

interface Props {
  badge?: string;
  title?: string;
  intro?: string;
  faqs?: Array<[string, string] | string[]>;
}

const { badge, title, intro, faqs = [] } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="grid gap-4 lg:grid-cols-2 md:items-center">
      <SectionHeading badge={badge} title={title} />
      <p class="text-muted">{intro}</p>
    </div>
    <div class="mx-auto mt-10 max-w-[820px] space-y-3">
      {faqs.map(([q, a]: any, i: number) => (
        <details open={i === 0} class="group rounded-[14px] border border-[#E7E6E6] open:border-[#FEB267] py-4 md:py-5 px-4 md:px-[22px] font-[Inter,sans-serif]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-base md:text-lg group-open:text-[#FE7E01] group-open:mb-4 text-[#6D6B69]">
            {q}
            <Icon name="down" class="h-5 w-5 shrink-0 transition -rotate-90 group-open:rotate-180" />
          </summary>
          <p class="border-t border-[#E7E6E6] pt-4 text-base text-[#858482]">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
