---
// "Request a Free Quote" form (home + contacts)
---
<div class="rounded-[20px] bg-[#FFF9F2] px-5 py-5 sm:px-8 sm:py-8 md:px-[35px] md:py-[25px]">
  <h3 class="text-xl sm:text-[28px] font-semibold text-dark">Request a Free Quote</h3>
  <form action="#" class="mt-[30px] grid gap-5 sm:grid-cols-2">
    <div class="relative sm:col-span-2">
      <select class="w-full appearance-none rounded-[12px] bg-white px-4 py-4 text-base text-[#858482] outline-none focus:border-brand focus:ring-1 focus:ring-brand" required>
        <option value="">Freight Type</option>
        <option>Sea Freight</option><option>Air Freight</option><option>Road Freight</option>
        <option>Multimodal Transport</option><option>Freight Forwarding</option><option>Parcel Courier</option>
        <option>Packaging and Storage</option><option>Car Transportation</option><option>Cargo Insurance</option>
      </select>
      <div class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </div>
    </div>
    <input type="email" class="w-full rounded-[12px] bg-white px-4  py-4 text-base text-[#858482] outline-none focus:border-brand focus:ring-1 focus:ring-brand sm:col-span-2 placeholder:text-[#858482]" placeholder="Email" required />
    <input class="w-full rounded-[12px] bg-white px-4  py-4 text-base text-[#858482] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="City of departure" />
    <input class="w-full rounded-[12px] bg-white px-4  py-4 text-base text-[#858482] outline-none focus:border-brand focus:ring-1 focus:ring-brand placeholder:text-[#858482]" placeholder="Delivery city" />
    <textarea rows="4" class="w-full min-h-[100px] max-h-[180px] resize-y overflow-y-auto rounded-[12px] bg-white px-4 py-4 text-base text-[#858482] outline-none focus:border-brand focus:ring-1 focus:ring-brand sm:col-span-2 placeholder:text-[#858482]" placeholder="Message"></textarea>
    <div class="pt-2 text-center sm:col-span-2">
      <button class="inline-block rounded-full bg-brand px-8 md:px-10 py-2 md:py-3 text-base font-bold uppercase tracking-wider text-black transition hover:bg-orange-600 cursor-pointer w-full max-w-[210px]">Submit</button>
    </div>
  </form>
</div>
