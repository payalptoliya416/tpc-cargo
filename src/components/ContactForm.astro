---
// "Request a Free Quote" form (home + contacts)
---
<div class="rounded-2xl bg-cream p-6 md:p-8">
  <h3 class="text-xl font-medium">Request a Free Quote</h3>
  <form action="#" class="mt-5 grid gap-3 sm:grid-cols-2">
    <select class="input sm:col-span-2" required>
      <option value="">Freight Type</option>
      <option>Sea Freight</option><option>Air Freight</option><option>Road Freight</option>
      <option>Multimodal Transport</option><option>Freight Forwarding</option><option>Parcel Courier</option>
      <option>Packaging and Storage</option><option>Car Transportation</option><option>Cargo Insurance</option>
    </select>
    <input type="email" class="input sm:col-span-2" placeholder="Email" required />
    <input class="input" placeholder="City of departure" />
    <input class="input" placeholder="Delivery city" />
    <textarea rows="5" class="input sm:col-span-2" placeholder="Message"></textarea>
    <div class="text-center sm:col-span-2"><button class="btn">Submit</button></div>
  </form>
</div>
