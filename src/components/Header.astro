---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navLinks, phone, email, hours, offices } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="bg-white">
  <div class="flex items-center justify-between gap-4 px-3 py-4 md:px-6">
    <div class="flex items-center gap-6">
      <Logo />
      <nav class="hidden items-center gap-6 text-sm md:flex">
        {navLinks.map((l) => (
          <a href={l.href} class:list={['hover:text-brand', isActive(l.href) && 'text-brand']}>{l.name}</a>
        ))}
      </nav>
    </div>

    <div class="hidden items-center gap-6 text-sm xl:flex">
      <a href={`tel:${phone}`} class="flex items-center gap-2"><Icon name="phone" class="h-4 w-4" />{phone}</a>
      <a href={`mailto:${email}`} class="flex items-center gap-2"><Icon name="mail" class="h-4 w-4" />{email}</a>
      <span class="flex items-center gap-2"><Icon name="clock" class="h-4 w-4" />{hours}</span>
    </div>

    <div class="flex items-center gap-3">
      <!-- Office dropdown -->
      <details class="relative hidden sm:block">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full bg-brand px-4 py-2 text-xs font-semibold text-white">
          Cyprus Office <Icon name="down" class="h-3 w-3" />
        </summary>
        <ul class="absolute right-0 z-20 mt-2 w-40 rounded-lg border bg-white p-2 text-sm shadow-lg">
          {offices.map((o) => <li><a href="/contacts" class="block rounded px-3 py-2 hover:bg-cream">{o.country} Office</a></li>)}
        </ul>
      </details>
      <!-- Mobile menu button -->
      <button id="menu-btn" class="md:hidden" aria-label="Open menu"><Icon name="menu" class="h-7 w-7" /></button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden border-t px-4 py-3 md:hidden">
    {navLinks.map((l) => (
      <a href={l.href} class:list={['block py-2 text-sm', isActive(l.href) && 'text-brand']}>{l.name}</a>
    ))}
  </nav>
</header>

<script>
  document.getElementById('menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
