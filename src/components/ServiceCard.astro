---
import { serviceImages } from '../data/images';
// One service card. dark = true for dark backgrounds (home page)
const { service, dark = false } = Astro.props;
---
<div class:list={['group/card flex h-full flex-col rounded-[18px] border p-4 transition-all duration-300 hover:shadow-xl', dark ? 'border-[#FFFFFF33] bg-white/5 text-white' : 'border-[#E7E6E6] bg-white']}>
  <img src={serviceImages[service.slug].card} alt={service.name} class="aspect-[16/10] w-full rounded-xl object-cover transition-transform duration-500 group-hover/card:scale-[1.02]" loading="lazy" />
  <div class="flex flex-1 flex-col pt-5">
    <h3 class="font-bold text-lg">{service.name}</h3>
    <p class:list={['mt-2 md:mt-4 flex-1 text-base leading-[28px]', dark ? 'text-gray-400' : 'text-[#858482]']}>{service.short}</p>
    <a href={`/services/${service.slug}`} class="mt-4 md:mt-6 inline-flex items-center gap-1 text-base font-medium text-[#FE9834] transition-all duration-300 group-hover/card:translate-x-1 w-fit">
      <span>Read More</span>
      <span class="inline-block transition-transform duration-300 group-hover/card:translate-x-1.5 text-lg font-bold">›</span>
    </a>
  </div>
</div>
