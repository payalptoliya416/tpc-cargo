---
import { serviceImages } from '../data/images';
// One service card. dark = true for dark backgrounds (home page)
const { service, dark = false } = Astro.props;
---
<div class:list={['flex h-full flex-col rounded-[18px] border p-4 group', dark ? 'border-[#FFFFFF33] bg-white/5 text-white' : 'border-[#E7E6E6] bg-white']}>
  <div class="aspect-[16/10] w-full rounded-xl overflow-hidden">
    <img src={serviceImages[service.slug].card} alt={service.name} class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.08]" loading="lazy" />
  </div>
  <div class="flex flex-1 flex-col pt-5 font-[Inter,sans-serif]">
    <h3 class="font-medium text-lg">{service.name}</h3>
    <p class:list={['mt-2 md:mt-4 flex-1 text-base leading-[28px]', dark ? 'text-gray-400' : 'text-[#858482]']}>{service.short}</p>
    <a href={`/services/${service.slug}`} class="mt-4 md:mt-6 text-base font-medium text-[#FE7E01] inline-flex items-center gap-1 group/link">
      <span>Read More</span>
      <span class="transition-transform duration-250 group-hover/link:translate-x-1.5">›</span>
    </a>
  </div>
</div>
