---
// One service card. dark = true for dark backgrounds (home page)
const { service, dark = false } = Astro.props;
---
<div class:list={['flex h-full flex-col rounded-2xl border p-3', dark ? 'border-white/10 bg-white/5 text-white' : 'border-gray-200 bg-white']}>
  <img src={`/images/${service.slug}.svg`} alt={service.name} class="aspect-[16/10] w-full rounded-xl object-cover" loading="lazy" />
  <div class="flex flex-1 flex-col p-2 pt-4">
    <h3 class="font-semibold">{service.name}</h3>
    <p class:list={['mt-3 flex-1 text-sm leading-6', dark ? 'text-gray-400' : 'text-gray-500']}>{service.short}</p>
    <a href={`/services/${service.slug}`} class="mt-4 text-sm font-medium text-brand">Read More ›</a>
  </div>
</div>
