---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---
<section class="section bg-gray-100">
  <div class="wrap">
    <div class="grid gap-4 md:grid-cols-2 md:items-end">
      <SectionHeading badge="Trusted by businesses" title="What [Our Clients Say About] TPC Cargo" />
      <p class="text-muted">Reliable service, responsive support, and flexible logistics solutions built around the needs of businesses moving cargo worldwide.</p>
    </div>
    <!-- scrolls sideways on mobile, 3 columns on desktop -->
    <div class="mt-10 flex snap-x gap-4 overflow-x-auto pb-2 md:grid md:grid-cols-3 md:overflow-visible">
      {testimonials.map((t) => (
        <div class="min-w-[85%] snap-start rounded-xl border bg-white p-5 md:min-w-0">
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/15 font-semibold text-brand">{t.name[0]}</div>
            <div><div class="text-sm font-semibold">{t.name}</div><div class="text-xs text-gray-500">{t.role}</div></div>
          </div>
          <div class="mt-4 flex text-brand">{[1, 2, 3, 4, 5].map(() => <Icon name="star" fill class="h-4 w-4" />)}</div>
          <h4 class="mt-3 text-sm font-semibold">{t.title}</h4>
          <p class="mt-2 text-sm italic leading-6 text-gray-500">“{t.text}”</p>
        </div>
      ))}
    </div>
  </div>
</section>
