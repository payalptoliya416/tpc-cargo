---
import Icon from './Icon.astro';
import { testimonials } from '../data/site';
---
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<section class="section bg-[#F3F3F3] py-16 xl:!py-[130px] relative overflow-hidden sm:overflow-visible">
  <div class="wrap space-y-5 sm:space-y-10">
    <!-- Header Row: Badge & Title Left, Subtitle Right -->
    <div class="grid gap-6 lg:grid-cols-2 md:items-center md:gap-14">
      <div>
        <span class="badge">Trusted by businesses</span>
        <h2 class="heading mt-6">What <span class="text-[#FE7E01]">Our Clients Say About</span><br />TPC Cargo</h2>
      </div>
      <p class="text-sm sm:text-base leading-[28px] text-[#858482]">
        Reliable Service, Responsive Support, And Flexible Logistics Solutions Built Around The Needs Of Businesses Moving Cargo Worldwide.
      </p>
    </div>

    <!-- Swiper Slider Container with Responsive Arrow Buttons -->
    <div class="relative w-full">
      <!-- Left Arrow Button -->
      <button
        id="testi-prev"
        aria-label="Previous testimonial"
        class="flex h-10 w-10 sm:h-[50px] sm:w-[50px] rounded-full border border-[#CECECD] bg-white/90 backdrop-blur-sm items-center justify-center text-[#0B0806] hover:border-brand hover:text-white hover:bg-brand transition shadow-lg cursor-pointer shrink-0 z-30 absolute left-2 sm:left-3 2xl:-left-16 top-[35%] sm:top-1/2  -translate-y-1/2"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <!-- Swiper Main Track -->
      <div class="swiper testimonials-swiper w-full overflow-hidden">
        <div class="swiper-wrapper py-2 items-stretch">
          {testimonials.map((t) => (
            <div class="swiper-slide !h-auto flex">
              <div class="w-full flex flex-col justify-between rounded-[18px] bg-white px-4 py-6 sm:py-10 sm:px-5 border border-[#E7E6E6]">
                <div>
                  <!-- Top Client Info Header -->
                  <div class="flex items-center gap-[10px]">
                    <img
                      src={t.avatar}
                      alt={t.name}
                      class="h-12 w-12 rounded-full object-cover shrink-0 bg-gray-100"
                      onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                    />
                    <div class="hidden h-11 w-11 rounded-full bg-brand/15 font-bold text-[#FE7E01] items-center justify-center text-sm shrink-0">{t.name[0]}</div>

                    <div>
                      <h4 class="text-lg font-semibold text-dark leading-tight">{t.name}</h4>
                      <p class="text-sm text-[#6D6B69] md:mt-2">{t.role}</p>
                    </div>
                  </div>

                  <!-- Rating Stars & Quote Icon -->
                  <div class="mt-8 flex items-center justify-between relative">
                    <div class="flex text-[#FF961F]">
                      {[1,2,3,4,5].map(() => (
                        <Icon name="star" class="h-5 w-5" />
                      ))}
                    </div>
                    <svg viewBox="0 0 24 24" class="h-10 w-10 text-[#FFF2E6] fill-current rotate-180 absolute right-0 top-3">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                  </div>

                  <!-- Review Title -->
                  <h5 class="mt-5 text-sm sm:text-lg font-medium text-dark leading-snug font-[Inter,sans-serif]">{t.title}</h5>

                  <!-- Review Text -->
                  <p class="mt-[15px] text-xs sm:text-sm italic leading-[26px] text-[#3C3A38]">"{t.text}"</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Arrow Button -->
      <button
        id="testi-next"
        aria-label="Next testimonial"
        class="flex h-10 w-10 sm:h-[50px] sm:w-[50px] rounded-full border border-[#CECECD] bg-white/90 backdrop-blur-sm items-center justify-center text-[#0B0806] hover:bg-brand hover:text-white transition shadow-lg cursor-pointer shrink-0 z-30 absolute right-2 sm:right-3 2xl:-right-16 top-[35%] sm:top-1/2  -translate-y-1/2"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script is:inline>
    function initTestiSwiper() {
      if (typeof Swiper !== 'undefined') {
        new Swiper('.testimonials-swiper', {
          slidesPerView: 1,
          spaceBetween: 24,
          slidesPerGroup: 1,
          loop: true,
          speed: 600,
          grabCursor: true,
          navigation: {
            nextEl: '#testi-next',
            prevEl: '#testi-prev',
          },
          breakpoints: {
            640: {
              slidesPerView: 2,
              slidesPerGroup: 1,
              spaceBetween: 24,
            },
            1024: {
              slidesPerView: 3,
              slidesPerGroup: 1,
              spaceBetween: 24,
            },
          },
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestiSwiper);
    } else {
      initTestiSwiper();
    }
  </script>
</section>

<style>
  .testimonials-swiper .swiper-wrapper {
    display: flex !important;
    align-items: stretch !important;
  }
  .testimonials-swiper .swiper-slide {
    height: auto !important;
    display: flex !important;
  }
</style>

