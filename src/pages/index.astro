---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Offices from '../components/Offices.astro';
import Map from '../components/Map.astro';
import { services } from '../data/services';

// Hero bottom links
const heroLinks = [
  { icon: 'ship-solid', name: 'Sea Freight', href: '/services/sea-freight' },
  { icon: 'plane-solid', name: 'Air Freight', href: '/services/air-freight' },
  { icon: 'truck-solid', name: 'Road Freight', href: '/services/road-freight' },
  { icon: 'warehouse-solid', name: 'Warehousing', href: '/services/packaging-and-storage' },
];

const heroSlides = [
  {
    badge: 'Time-sensitive shipping',
    title: 'Faster <span class="text-[#FE7E01]">Air Freight</span> For Time<br />Critical Cargo',
    text: 'Keep your shipments moving with dependable air transportation built around speed, security,<br class="hidden md:block" /> and global connectivity.',
    image: '/images/air-freight-sol.png',
  },
  {
    badge: 'Global ocean freight',
    title: 'Reliable <span class="text-[#FE7E01]">Sea Freight</span> For Global Trade',
    text: 'Connect your business to destinations worldwide with cost-effective<br class="hidden md:block" /> FCL, LCL, and RoRo cargo solutions.',
    image: '/images/sea-freight-hero.png',
  },
  {
    badge: 'Fast & flexible logistics',
    title: 'Dependable <span class="text-[#FE7E01]">Road Freight</span> Delivered On Time',
    text: 'Flexible trucking and door-to-door road transportation across key<br class="hidden md:block" /> regional and international trade routes.',
    image: '/images/road-freight-sol.png',
  },
  {
    badge: 'Secure logistics & storage',
    title: 'Smart <span class="text-[#FE7E01]">Warehousing</span> & Cargo Management',
    text: 'Safe, scalable storage, packing, and distribution solutions tailored<br class="hidden md:block" /> to your global supply chain.',
    image: '/images/packaging-and-storage-sol.jpg',
  },
];

// Cards in the dark section
const beyond = ['packaging-and-storage', 'car-transportation', 'cargo-insurance', 'sea-freight', 'air-freight', 'road-freight', 'multimodal-transport', 'parcel-courier'].map((slug) => services.find((s) => s.slug === slug)).filter((s): s is import('../data/services').Service => Boolean(s));
const special = [
  { icon: 'box', name: 'Packaging and Storage' },
  { icon: 'warehouse', name: 'Warehousing service' },
  { icon: 'globe', name: 'Multimodal Transport' },
  { icon: 'truck', name: 'Logistic Services' },
];
---
<Layout title="TPC Cargo | Cyprus, Globally Connected">
  <!-- Hero -->
<section class="px-3 md:px-6">
  <div
    id="hero-slider-container"
    class="relative h-[500px] sm:h-[620px] md:h-[700px] lg:h-[770px] overflow-hidden rounded-2xl sm:rounded-3xl bg-dark text-white select-none"
  >
    <!-- Background Images Container for Crossfade -->
    <div id="hero-bg-container" class="absolute inset-0">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-bg-item absolute inset-0 bg-cover bg-center transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-0' : 'opacity-0 -z-10'}`}
          style={`background-image: url('${slide.image}')`}
          data-slide-index={index}
        ></div>
      ))}
    </div>

    <!-- Dark Overlay -->

    <!-- Right Pagination Dots matching screenshot -->
    <div
      id="hero-pagination-dots"
      class="absolute right-7 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-center gap-3 sm:flex"
    >
      {heroSlides.map((_, index) => (
        <button
          aria-label={`Go to slide ${index + 1}`}
          data-index={index}
          class={`hero-dot transition-all duration-300 cursor-pointer ${
            index === 0
              ? 'h-3 w-3 rounded-full border-2 border-brand bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-black'
              : 'h-2 w-2 rounded-full bg-white/40 hover:bg-white/80'
          }`}
        ></button>
      ))}
    </div>

    <!-- Main Content Items -->
    <div class="relative z-20 flex h-full flex-col items-center text-center">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-content-item absolute inset-x-0 top-0 flex flex-col items-center text-center transition-all duration-700 ease-in-out px-4 sm:px-6 ${
            index === 0
              ? 'opacity-100 translate-y-0 pointer-events-auto z-10'
              : 'opacity-0 translate-y-4 pointer-events-none -z-10'
          }`}
          data-slide-index={index}
        >
          <!-- Badge -->
          <div class="mt-16 md:mt-[130px] lg:mt-[170px] badge-dark">{slide.badge}</div>

          <!-- Heading -->
          <h1
            class="mx-auto mt-4 sm:mt-6 md:mt-10 max-w-[950px] text-3xl font-medium leading-[1.18] text-white sm:text-4xl md:text-[56px] lg:text-[74px]"
            set:html={slide.title}
          />

          <!-- Description -->
          <p
            class="mx-auto mt-3 sm:mt-5 md:mt-[35px] max-w-[900px] text-sm leading-[20px] sm:leading-5 text-[#B6B5B4] sm:text-base md:text-lg"
            set:html={slide.text}
          />
        </div>
      ))}

      <!-- Bottom Navigation -->
      <div
        class="absolute bottom-0 left-0 w-full grid grid-cols-2 divide-x divide-white/10 border-t border-white/10 bg-black/55 backdrop-blur-md md:grid-cols-4 z-30"
      >
        {heroLinks.map((l, index) => (
          <button
            data-nav-index={index}
            class={`hero-nav-item flex h-[75px] sm:h-[100px] md:h-[125px] flex-col items-center justify-center gap-1.5 sm:gap-3 text-xs sm:text-sm font-medium text-white transition-all cursor-pointer ${
              index === 1 ? 'bg-white/10 text-[#FE7E01] font-bold' : 'hover:bg-white/5 hover:text-[#FE7E01]'
            }`}
          >
            <Icon
              name={l.icon}
              class="h-5 w-5 sm:h-7 sm:w-7 md:h-8 md:w-8 text-white fill-white"
            />
            <span class="text-xs sm:text-base lg:text-xl">
              {l.name}
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function initHeroSlider() {
    const container = document.getElementById('hero-slider-container');
    if (!container) return;

    const bgItems = container.querySelectorAll('.hero-bg-item');
    const contentItems = container.querySelectorAll('.hero-content-item');
    const dots = container.querySelectorAll('.hero-dot');
    const navItems = container.querySelectorAll('.hero-nav-item');

    let currentIndex = 0;
    const totalSlides = bgItems.length;
    let autoPlayTimer = null;

    // Map nav index (0:Sea, 1:Air, 2:Road, 3:Warehousing) to slide index
    const navToSlideMap = {
      0: 1, // Sea Freight -> slide 1
      1: 0, // Air Freight -> slide 0
      2: 2, // Road Freight -> slide 2
      3: 3, // Warehousing -> slide 3
    };

    function goToSlide(newIndex) {
      if (newIndex === currentIndex) return;

      bgItems.forEach((bg, idx) => {
        if (idx === newIndex) {
          bg.classList.remove('opacity-0', '-z-10');
          bg.classList.add('opacity-100', 'z-0');
        } else {
          bg.classList.remove('opacity-100', 'z-0');
          bg.classList.add('opacity-0', '-z-10');
        }
      });

      contentItems.forEach((content, idx) => {
        if (idx === newIndex) {
          content.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none', '-z-10');
          content.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
        } else {
          content.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
          content.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none', '-z-10');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === newIndex) {
          dot.className = 'hero-dot h-3 w-3 rounded-full border-2 border-brand bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-black transition-all duration-300 cursor-pointer';
        } else {
          dot.className = 'hero-dot h-2 w-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300 cursor-pointer';
        }
      });

      navItems.forEach((nav, navIdx) => {
        const targetSlide = navToSlideMap[navIdx];
        if (targetSlide === newIndex) {
          nav.classList.add('bg-white/15', 'text-[#FE7E01]');
        } else {
          nav.classList.remove('bg-white/15', 'text-[#FE7E01]');
        }
      });

      currentIndex = newIndex;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % totalSlides;
      goToSlide(next);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        goToSlide(idx);
        startAutoPlay();
      });
    });

    navItems.forEach((nav) => {
      nav.addEventListener('click', () => {
        const navIdx = parseInt(nav.getAttribute('data-nav-index') || '0', 10);
        const slideIdx = navToSlideMap[navIdx];
        if (slideIdx !== undefined) {
          goToSlide(slideIdx);
          startAutoPlay();
        }
      });
    });

    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);

    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
</script>

  <!-- About -->
  <section class="section">
    <div class="wrap grid items-center gap-[60px] lg:grid-cols-2">
      <div>
        <span class="badge">About TPC Cargo</span>
        <h2 class="heading"><span class="text-[#FE7E01]">Cyprus Cargo,</span><br />Globally Connected.</h2>
        <p class="text-muted mt-6"><strong>TPC Cargo service part of TPC EXPRESS LTD</strong>, enables Cyprus cargo access to strategic regions, countries and markets. Combining our knowledge with a superior customer service skills, and together with a network of key port terminals, road/rail access routes, warehousing and our trusted worldwide partners – we promise reliability and the highest level of professional services, at the most competitive rates.</p>
        <p class="text-muted mt-5"><strong>Founded in 2015 in Cyprus</strong>, the vast experience we collect over the years in the transportation industry served as the best input for building and establishing <strong>TPC Cargo</strong> as a major regional and global cargo logistics provider.</p>
      </div>
      <div class="relative group cursor-pointer" id="video-play-trigger">
        <img src="/images/about-team.jpg" alt="TPC Cargo team" class="aspect-[3/2] w-full rounded-2xl object-cover shadow-md transition-transform duration-500 group-hover:scale-[1.01]" />
        
        <!-- Play Button Overlay matching screenshot -->
        <div class="absolute inset-0 flex items-center justify-center z-10">
          <button
            aria-label="Play video"
            class="relative flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white shadow-xl transition-all duration-300 group-hover:scale-110 cursor-pointer"
          >
            <!-- Pulsing Ripple Animation -->
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60"></span>
            
            <!-- Play Icon -->
            <svg class="relative h-7 w-7 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>

        <!-- 10+ Years Experience Badge -->
        <div class="absolute -bottom-5 -left-4 rounded-xl bg-brand px-6 py-4 text-white shadow-lg z-20">
          <div class="text-2xl font-semibold">10+</div>
          <div class="text-xs font-medium">Years of Experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Lightbox Popup Modal -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="TPC Cargo Video"
  >
    <div class="relative w-full max-w-4xl aspect-video rounded-2xl overflow-hidden bg-black shadow-2xl scale-95 transition-transform duration-300" id="video-modal-content">
      <!-- Close Button -->
      <button
        id="video-modal-close"
        aria-label="Close video modal"
        class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-white hover:bg-brand transition-colors cursor-pointer"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Video iFrame -->
      <iframe
        id="video-iframe"
        class="w-full h-full border-0"
        src=""
        data-src="https://www.youtube-nocookie.com/embed/3JZ_D3ELwOQ?autoplay=1&enablejsapi=1"
        title="TPC Cargo Video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <script is:inline>
    function initVideoModal() {
      const trigger = document.getElementById('video-play-trigger');
      const modal = document.getElementById('video-modal');
      const modalContent = document.getElementById('video-modal-content');
      const closeBtn = document.getElementById('video-modal-close');
      const iframe = document.getElementById('video-iframe');

      if (!trigger || !modal || !iframe) return;

      function openModal() {
        const videoSrc = iframe.getAttribute('data-src');
        if (videoSrc) iframe.src = videoSrc;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        if (modalContent) {
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        iframe.src = '';
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        if (modalContent) {
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
      initVideoModal();
    }
  </script>

  <Stats />

  <!-- Beyond shipping (dark) -->
  <section class="section relative mt-14 bg-dark text-white md:mt-20 overflow-hidden py-16">
    <div class="wrap relative">
      <!-- Header row -->
      <div class="grid gap-4 md:grid-cols-2 md:items-center mb-10 lg:pl-10">
        <SectionHeading light badge="Beyond the ordinary" title="More Than Shipping, [Complete Logistics Support.]" />
        <p class="text-lg leading-[30px] text-[#9D9C9B]">Experience the best in international transport with our special services. From cargo shipments to customs clearance, our team is ready to meet all your needs.</p>
      </div>

      <!-- Slider Container Layout: Left Dots + Slider Track -->
      <div class="flex flex-col lg:flex-row items-center lg:items-stretch gap-6 lg:gap-6">
        <!-- Desktop Left Vertical Dots -->
        <div class="hidden lg:flex flex-col justify-center gap-3.5 shrink-0 z-20 w-4" id="beyond-slider-dots-desktop">
          <button data-index="0" aria-label="Slide 1" class="slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer"></button>
          <button data-index="1" aria-label="Slide 2" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
          <button data-index="2" aria-label="Slide 3" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
          <button data-index="3" aria-label="Slide 4" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        </div>

        <!-- Slider Track Wrapper with Left Clipping & Right Bleed -->
        <div class="grow min-w-0 w-full [clip-path:none] lg:[clip-path:inset(-20px_-2000px_-20px_0px)]">
          <div class="swiper beyond-swiper !overflow-visible select-none">
            <div class="swiper-wrapper">
              {beyond.map((s) => (
                <div class="swiper-slide !h-auto">
                  <ServiceCard service={s} dark />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile / Tablet Bottom Horizontal Dots -->
      <div class="flex lg:hidden justify-center items-center gap-3.5 mt-8 z-20" id="beyond-slider-dots-mobile">
        <button data-index="0" aria-label="Slide 1" class="slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer"></button>
        <button data-index="1" aria-label="Slide 2" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        <button data-index="2" aria-label="Slide 3" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        <button data-index="3" aria-label="Slide 4" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
      </div>
    </div>
  </section>

  <CtaBanner badge="Our promise" title="Reach your destination [100% sure and safe]" text="We provide complete solutions that will fit any transportation industry size. We will take care of your cargo and deliver safely and on time!" />

  <!-- What makes us special -->
  <section class="section !pb-11">
    <div class="wrap grid items-start gap-[60px] lg:grid-cols-2">
      <div>
        <SectionHeading badge="About TPC Cargo" title="What makes [us special?]" />
        <p class="text-muted mt-4">We offer reliability and the highest level of professional services, at the most competitive rates.</p>
        <div class="mt-5 md:mt-8 grid gap-5 sm:grid-cols-2">
          {special.map((s) => (
            <div class="flex items-center gap-3 rounded-lg bg-[#F3F3F3] py-5 md:py-[25px] px-6 md:px-[35px] text-sm font-medium"><Icon name={s.icon} class="h-7 w-7 shrink-0 text-[#FE7E01]" />{s.name}</div>
          ))}
        </div>
      </div>
      <ContactForm />
    </div>
  </section>

  <Offices />
  <Map />

  <script>
    import Swiper from 'swiper';
    import 'swiper/css';

    const initSwiper = () => {
      const dots = document.querySelectorAll('.slider-dot');
      const swiperContainer = document.querySelector('.beyond-swiper');

      if (swiperContainer) {
        const swiper = new Swiper('.beyond-swiper', {
          slidesPerView: 1.15,
          spaceBetween: 16,
          grabCursor: true,
          speed: 400,
          breakpoints: {
            640: {
              slidesPerView: 2.15,
              spaceBetween: 20,
            },
            1024: {
              slidesPerView: 3.3,
              spaceBetween: 24,
            },
          },
          on: {
            slideChange: function (s) {
              const totalSlides = s.slides.length;
              const maxIndex = Math.max(1, totalSlides - 3);
              const activeIdx = Math.min(3, Math.round((s.activeIndex / maxIndex) * 3));

              dots.forEach((d) => {
                const dotIdx = parseInt(d.getAttribute('data-index') || '0', 10);
                if (dotIdx === activeIdx) {
                  d.className = 'slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer';
                } else {
                  d.className = 'slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer';
                }
              });
            },
          },
        });

        if (dots.length) {
          dots.forEach((dot) => {
            dot.addEventListener('click', () => {
              const index = parseInt(dot.getAttribute('data-index') || '0', 10);
              const totalSlides = swiper.slides.length;
              const maxIndex = Math.max(1, totalSlides - 3);
              const targetSlide = Math.round((index / 3) * maxIndex);
              swiper.slideTo(targetSlide);
            });
          });
        }
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwiper);
    } else {
      initSwiper();
    }
  </script>
</Layout>
