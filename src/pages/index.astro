---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Offices from '../components/Offices.astro';
import Map from '../components/Map.astro';
import { services } from '../data/services';

// Hero bottom links
const heroLinks = [
  { icon: 'ship', name: 'Sea Freight', href: '/services/sea-freight' },
  { icon: 'plane', name: 'Air Freight', href: '/services/air-freight' },
  { icon: 'truck', name: 'Road Freight', href: '/services/road-freight' },
  { icon: 'warehouse', name: 'Warehousing', href: '/services/packaging-and-storage' },
];
// Cards in the dark section
const beyond = ['packaging-and-storage', 'car-transportation', 'cargo-insurance', 'sea-freight', 'air-freight', 'road-freight', 'multimodal-transport', 'parcel-courier'].map((slug) => services.find((s) => s.slug === slug)).filter((s): s is import('../data/services').Service => Boolean(s));
const special = [
  { icon: 'box', name: 'Packaging and Storage' },
  { icon: 'warehouse', name: 'Warehousing service' },
  { icon: 'globe', name: 'Multimodal Transport' },
  { icon: 'truck', name: 'Logistic Services' },
];
---
<Layout title="TPC Cargo | Cyprus, Globally Connected">
  <!-- Hero -->
<section class="px-3 md:px-6">
  <div
    class="relative h-[770px] overflow-hidden rounded-3xl bg-dark bg-cover bg-center text-white"
    style="background-image:url('/images/air-freight-sol.png')"
  >
    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black/70"></div>

    <!-- Right Pagination -->
    <div
      class="absolute right-7 top-1/2 z-20 hidden -translate-y-1/2 flex-col items-center gap-3 sm:flex"
    >
      <span class="h-3 w-3 rounded-full border-2 border-brand bg-brand"></span>
      <span class="h-2 w-2 rounded-full bg-white/40"></span>
      <span class="h-2 w-2 rounded-full bg-white/40"></span>
      <span class="h-2 w-2 rounded-full bg-white/40"></span>
    </div>

    <!-- Main Content -->
    <div class="relative z-10 flex h-full flex-col items-center text-center">

      <!-- Badge -->
      <div
        class="mt-[175px] inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-2 backdrop-blur-md"
      >
        <span class="h-2 w-2 rounded-full bg-brand"></span>

        <span
          class="text-xs font-semibold uppercase tracking-wider text-brand"
        >
          Time-sensitive shipping
        </span>
      </div>

      <!-- Heading -->
      <h1
        class="mx-auto mt-10 max-w-[950px] text-4xl font-normal leading-[1.18] text-white sm:text-5xl md:text-[58px] lg:text-[70px]"
      >
        Faster
        <span class="text-brand">Air Freight</span>
        For Time
        <br />
        Critical Cargo
      </h1>

      <!-- Description -->
      <p
        class="mx-auto mt-10 max-w-[900px] text-sm leading-7 text-gray-200 sm:text-base md:text-lg"
      >
        Keep your shipments moving with dependable air transportation built
        around speed, security, and
        <br class="hidden md:block" />
        global connectivity.
      </p>

      <!-- Bottom Navigation -->
      <div
        class="absolute bottom-0 left-0 w-full grid grid-cols-2 divide-x divide-white/10 border-t border-white/10 bg-black/55 backdrop-blur-md md:grid-cols-4"
      >
        {heroLinks.map((l) => (
          <a
            href={l.href}
            class="flex h-[125px] flex-col items-center justify-center gap-3 text-sm font-medium text-white transition hover:text-brand"
          >
            <Icon
              name={l.icon}
              class="h-8 w-8 text-white fill-white"
            />

            <span class="text-base md:text-lg">
              {l.name}
            </span>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

  <!-- About -->
  <section class="section">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="badge">About TPC Cargo</span>
        <h2 class="heading"><span class="text-brand">Cyprus Cargo,</span><br />Globally Connected.</h2>
        <p class="text-muted mt-5">TPC Cargo service part of TPC EXPRESS LTD, enables Cyprus cargo access to strategic regions, countries and markets. Combining our knowledge with a superior customer service skills, and together with a network of key port terminals, road/rail access routes, warehousing and our trusted worldwide partners – we promise reliability and the highest level of professional services, at the most competitive rates.</p>
        <p class="text-muted mt-4">Founded in 2015 in Cyprus, the vast experience we collect over the years in the transportation industry served as the best input for building and establishing TPC Cargo as a major regional and global cargo logistics provider.</p>
      </div>
      <div class="relative group cursor-pointer" id="video-play-trigger">
        <img src="/images/about-team.jpg" alt="TPC Cargo team" class="aspect-[3/2] w-full rounded-2xl object-cover shadow-md transition-transform duration-500 group-hover:scale-[1.01]" />
        
        <!-- Play Button Overlay matching screenshot -->
        <div class="absolute inset-0 flex items-center justify-center z-10">
          <button
            aria-label="Play video"
            class="relative flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white shadow-xl transition-all duration-300 group-hover:scale-110 cursor-pointer"
          >
            <!-- Pulsing Ripple Animation -->
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60"></span>
            
            <!-- Play Icon -->
            <svg class="relative h-7 w-7 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>

        <!-- 10+ Years Experience Badge -->
        <div class="absolute -bottom-5 -left-4 rounded-xl bg-brand px-6 py-4 text-white shadow-lg z-20">
          <div class="text-2xl font-semibold">10+</div>
          <div class="text-xs font-medium">Years of Experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Lightbox Popup Modal -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="TPC Cargo Video"
  >
    <div class="relative w-full max-w-4xl aspect-video rounded-2xl overflow-hidden bg-black shadow-2xl scale-95 transition-transform duration-300" id="video-modal-content">
      <!-- Close Button -->
      <button
        id="video-modal-close"
        aria-label="Close video modal"
        class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-white hover:bg-brand transition-colors cursor-pointer"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Video iFrame -->
      <iframe
        id="video-iframe"
        class="w-full h-full border-0"
        src=""
        data-src="https://www.youtube-nocookie.com/embed/3JZ_D3ELwOQ?autoplay=1&enablejsapi=1"
        title="TPC Cargo Video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <script is:inline>
    function initVideoModal() {
      const trigger = document.getElementById('video-play-trigger');
      const modal = document.getElementById('video-modal');
      const modalContent = document.getElementById('video-modal-content');
      const closeBtn = document.getElementById('video-modal-close');
      const iframe = document.getElementById('video-iframe');

      if (!trigger || !modal || !iframe) return;

      function openModal() {
        const videoSrc = iframe.getAttribute('data-src');
        if (videoSrc) iframe.src = videoSrc;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        if (modalContent) {
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        iframe.src = '';
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        if (modalContent) {
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
      initVideoModal();
    }
  </script>

  <Stats />

  <!-- Beyond shipping (dark) -->
  <section class="section relative mt-14 bg-dark text-white md:mt-20 overflow-hidden py-16">
    <div class="wrap relative pl-6 sm:pl-10 md:pl-14">
      <!-- Left side vertical slider pagination dots -->
      <div class="absolute left-0 sm:left-1 md:left-2 top-1/2 -translate-y-1/2 flex flex-col gap-3.5 z-20" id="beyond-slider-dots">
        <button data-index="0" aria-label="Slide 1" class="slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer"></button>
        <button data-index="1" aria-label="Slide 2" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        <button data-index="2" aria-label="Slide 3" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
      </div>

      <div class="grid gap-4 md:grid-cols-2 md:items-end mb-10">
        <SectionHeading light badge="Beyond the ordinary" title="More Than Shipping, [Complete Logistics Support.]" />
        <p class="text-sm leading-7 text-gray-400">Experience the best in international transport with our special services. From cargo shipments to customs clearance, our team is ready to meet all your needs.</p>
      </div>

      <div id="beyond-slider-track" class="flex gap-6 overflow-x-auto pb-4 no-scrollbar scroll-smooth cursor-grab select-none">
        {beyond.map((s) => (
          <div class="w-[85%] sm:w-[45%] lg:w-[32%] snap-start shrink-0">
            <ServiceCard service={s} dark />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner badge="Our promise" title="Reach your destination [100% sure and safe]" text="We provide complete solutions that will fit any transportation industry size. We will take care of your cargo and deliver safely and on time!" />

  <!-- What makes us special -->
  <section class="section">
    <div class="wrap grid items-start gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading badge="About TPC Cargo" title="What makes [us special?]" />
        <p class="text-muted mt-4">We offer reliability and the highest level of professional services, at the most competitive rates.</p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {special.map((s) => (
            <div class="flex items-center gap-3 rounded-lg bg-cream p-4 text-sm font-medium"><Icon name={s.icon} class="h-7 w-7 shrink-0 text-brand" />{s.name}</div>
          ))}
        </div>
      </div>
      <ContactForm />
    </div>
  </section>

  <Offices />
  <Map />

  <script>
    const track = document.getElementById('beyond-slider-track');
    const dots = document.querySelectorAll('#beyond-slider-dots .slider-dot');

    if (track) {
      // Mouse drag-to-scroll implementation
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.style.cursor = 'grabbing';
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.style.cursor = 'grab';
      });

      track.addEventListener('mouseup', () => {
        isDown = false;
        track.style.cursor = 'grab';
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });

      // Dots navigation
      if (dots.length) {
        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.getAttribute('data-index') || '0', 10);
            const maxScroll = track.scrollWidth - track.clientWidth;
            const scrollAmount = (maxScroll / (dots.length - 1)) * index;
            track.scrollTo({ left: scrollAmount, behavior: 'smooth' });
          });
        });

        track.addEventListener('scroll', () => {
          const maxScroll = track.scrollWidth - track.clientWidth;
          if (maxScroll <= 0) return;
          const progress = track.scrollLeft / maxScroll;
          const activeIndex = Math.min(dots.length - 1, Math.round(progress * (dots.length - 1)));

          dots.forEach((d, idx) => {
            if (idx === activeIndex) {
              d.className = 'slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer';
            } else {
              d.className = 'slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer';
            }
          });
        });
      }
    }
  </script>
</Layout>
