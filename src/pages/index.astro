---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import Offices from '../components/Offices.astro';
import Map from '../components/Map.astro';
import { services } from '../data/services';

// Hero bottom links
const heroLinks = [
  { icon: '/images/sea.svg', name: 'Sea Freight', href: '/services/sea-freight' },
  { icon: '/images/air.svg', name: 'Air Freight', href: '/services/air-freight' },
  { icon: '/images/road.svg', name: 'Road Freight', href: '/services/road-freight' },
  { icon: '/images/warehous.svg', name: 'Warehousing', href: '/services/packaging-and-storage' },
];

const heroSlides = [
  {
    badge: 'Time-sensitive shipping',
    title: 'Faster <span class="text-[#FE7E01]">Air Freight</span> For Time<br />Critical Cargo',
    text: 'Keep your shipments moving with dependable air transportation built around speed, security,<br class="hidden md:block" /> and global connectivity.',
    image: '/images/air-freight-sol.png',
  },
  {
    badge: 'Global ocean freight',
    title: 'Reliable <span class="text-[#FE7E01]">Sea Freight</span> For Global Trade',
    text: 'Connect your business to destinations worldwide with cost-effective<br class="hidden md:block" /> FCL, LCL, and RoRo cargo solutions.',
    image: '/images/sea-freight-hero.png',
  },
  {
    badge: 'Fast & flexible logistics',
    title: 'Dependable <span class="text-[#FE7E01]">Road Freight</span> Delivered On Time',
    text: 'Flexible trucking and door-to-door road transportation across key<br class="hidden md:block" /> regional and international trade routes.',
    image: '/images/road-freight-sol.png',
  },
  {
    badge: 'Secure logistics & storage',
    title: 'Smart <span class="text-[#FE7E01]">Warehousing</span> & Cargo Management',
    text: 'Safe, scalable storage, packing, and distribution solutions tailored<br class="hidden md:block" /> to your global supply chain.',
    image: '/images/packaging-and-storage-sol.jpg',
  },
];

// Cards in the dark section
const beyond = ['packaging-and-storage', 'car-transportation', 'cargo-insurance', 'sea-freight', 'air-freight', 'road-freight', 'multimodal-transport', 'parcel-courier'].map((slug) => services.find((s) => s.slug === slug)).filter((s): s is import('../data/services').Service => Boolean(s));
const special = [
  { icon: '/images/pakage.svg', name: 'Packaging and Storage' },
  { icon: '/images/service.svg', name: 'Warehousing service' },
  { icon: '/images/transport.svg', name: 'Multimodal Transport' },
  { icon: '/images/logist.svg', name: 'Logistic Services' },
];
---
<Layout title="TPC Cargo | Cyprus, Globally Connected">
  <!-- Hero -->
<section class="px-3 md:px-6">
  <div
    id="hero-slider-container"
    class="relative h-[500px] sm:h-[620px] md:h-[700px] lg:h-[770px] overflow-hidden rounded-2xl sm:rounded-3xl bg-dark text-white select-none"
  >
    <!-- Background Images -->
    <div id="hero-bg-container" class="absolute inset-0 overflow-hidden">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-bg-item absolute inset-0 ${index === 0 ? 'is-active' : ''}`}
          data-slide-index={index}
          data-anim={['reveal-left', 'reveal-top', 'zoom-in', 'reveal-diagonal'][index]}
        >
          <!-- clip-path reveal wrapper -->
          <div class="hero-bg-reveal absolute inset-0">
            <img
              src={slide.image}
              alt=""
              class="hero-bg-img absolute inset-0 h-full w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
          <!-- Overlays -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-black/15"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-transparent"></div>
        </div>
      ))}
    </div>

    <!-- Right Pagination Dots -->
    <div
      id="hero-pagination-dots"
      class="absolute right-7 top-1/2 z-30 hidden -translate-y-1/2 flex-col items-center gap-3 sm:flex"
    >
      {heroSlides.map((_, index) => (
        <button
          aria-label={`Go to slide ${index + 1}`}
          data-index={index}
          class={`hero-dot cursor-pointer rounded-full transition-all duration-300 ${
            index === 0
              ? 'h-3 w-3 border-2 border-brand bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-black'
              : 'h-2 w-2 bg-white/40 hover:bg-white/70'
          }`}
        ></button>
      ))}
    </div>

    <!-- Main Content Items -->
    <div class="relative z-20 flex h-full flex-col items-center text-center">
      {heroSlides.map((slide, index) => (
        <div
          class={`hero-content-item absolute inset-x-0 top-0 flex flex-col items-center text-center px-4 sm:px-6 ${
            index === 0 ? 'is-active' : ''
          }`}
          data-slide-index={index}
        >
          <!-- Badge -->
          <div class="hero-el mt-16 md:mt-[130px] lg:mt-[170px] badge-dark">{slide.badge}</div>

          <!-- Heading -->
          <h1
            class="hero-el mx-auto mt-4 sm:mt-6 md:mt-10 max-w-[950px] text-3xl font-medium leading-[1.18] text-white sm:text-4xl md:text-[56px] lg:text-[74px]"
            set:html={slide.title}
          />

          <!-- Description -->
          <p
            class="hero-el mx-auto mt-3 sm:mt-5 md:mt-[35px] max-w-[900px] text-sm leading-[20px] sm:leading-[30px] text-[#B6B5B4] sm:text-base md:text-lg"
            set:html={slide.text}
          />
        </div>
      ))}

      <!-- Bottom Navigation -->
      <div
        class="absolute bottom-0 left-0 w-full grid grid-cols-2 divide-x divide-white/10 border-t border-white/10 bg-black/55 backdrop-blur-md md:grid-cols-4 z-30"
      >
        {heroLinks.map((l, index) => (
          <button
            data-nav-index={index}
            class={`hero-nav-item flex h-[75px] sm:h-[100px] md:h-[125px] flex-col items-center justify-center gap-1.5 sm:gap-3 text-xs sm:text-sm font-medium text-white transition-all cursor-pointer ${
              index === 1 ? 'is-active bg-white/12 text-[#FE9834] font-bold' : ''
            }`}
          >
            {l.icon.includes('/') || l.icon.endsWith('.svg') ? (
              <img src={l.icon} alt="" class="h-5 w-5 sm:h-7 sm:w-7 md:h-8 md:w-8 object-contain" />
            ) : (
              <Icon name={l.icon} class="h-5 w-5 sm:h-7 sm:w-7 md:h-8 md:w-8 text-white fill-white" />
            )}
            <span class="text-xs sm:text-base lg:text-xl">{l.name}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ══════════════════════════════════════
   SLIDE LAYER STACKING & COVER IMAGE FITS
══════════════════════════════════════ */
.hero-bg-item {
  z-index: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.5s ease;
}
.hero-bg-item.is-active {
  z-index: 2;
  opacity: 1;
}
.hero-bg-item.is-leaving {
  z-index: 1;
  opacity: 0;
  transition: opacity 0.6s ease;
}

.hero-bg-reveal {
  width: 100%;
  height: 100%;
}

.hero-bg-img {
  will-change: transform;
}

/* Slide 0 — reveal-left (curtain L→R wipe) */
.hero-bg-item[data-anim="reveal-left"] .hero-bg-reveal {
  clip-path: inset(0 100% 0 0);
  transition: none;
}
.hero-bg-item[data-anim="reveal-left"].is-active .hero-bg-reveal {
  clip-path: inset(0 0% 0 0);
  transition: clip-path 0.9s cubic-bezier(0.77, 0, 0.175, 1);
}
.hero-bg-item[data-anim="reveal-left"] .hero-bg-img {
  transform: scale(1.08);
  transition: none;
}
.hero-bg-item[data-anim="reveal-left"].is-active .hero-bg-img {
  transform: scale(1.0);
  transition: transform 7s ease-out;
}

/* Slide 1 — reveal-top (curtain T→B wipe) */
.hero-bg-item[data-anim="reveal-top"] .hero-bg-reveal {
  clip-path: inset(0 0 100% 0);
  transition: none;
}
.hero-bg-item[data-anim="reveal-top"].is-active .hero-bg-reveal {
  clip-path: inset(0 0 0% 0);
  transition: clip-path 0.9s cubic-bezier(0.77, 0, 0.175, 1);
}
.hero-bg-item[data-anim="reveal-top"] .hero-bg-img {
  transform: scale(1.08);
  transition: none;
}
.hero-bg-item[data-anim="reveal-top"].is-active .hero-bg-img {
  transform: scale(1.0);
  transition: transform 7s ease-out;
}

/* Slide 2 — zoom-in */
.hero-bg-item[data-anim="zoom-in"] .hero-bg-reveal {
  clip-path: inset(0 0 0 0);
  transition: none;
}
.hero-bg-item[data-anim="zoom-in"] .hero-bg-img {
  transform: scale(1.15);
  transition: none;
}
.hero-bg-item[data-anim="zoom-in"].is-active .hero-bg-img {
  transform: scale(1.0);
  transition: transform 7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Slide 3 — reveal-diagonal (R→L curtain wipe) */
.hero-bg-item[data-anim="reveal-diagonal"] .hero-bg-reveal {
  clip-path: inset(0 0 0 100%);
  transition: none;
}
.hero-bg-item[data-anim="reveal-diagonal"].is-active .hero-bg-reveal {
  clip-path: inset(0 0 0 0);
  transition: clip-path 0.9s cubic-bezier(0.77, 0, 0.175, 1);
}
.hero-bg-item[data-anim="reveal-diagonal"] .hero-bg-img {
  transform: scale(1.08);
  transition: none;
}
.hero-bg-item[data-anim="reveal-diagonal"].is-active .hero-bg-img {
  transform: scale(1.0);
  transition: transform 7s ease-out;
}

/* Content stagger */
.hero-content-item {
  pointer-events: none;
  z-index: 0;
}
.hero-content-item.is-active {
  pointer-events: auto;
  z-index: 3;
}
.hero-el {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.hero-content-item.is-active .hero-el:nth-child(1) {
  opacity: 1; transform: translateY(0);
  transition-delay: 0.4s;
}
.hero-content-item.is-active .hero-el:nth-child(2) {
  opacity: 1; transform: translateY(0);
  transition-delay: 0.55s;
}
.hero-content-item.is-active .hero-el:nth-child(3) {
  opacity: 1; transform: translateY(0);
  transition-delay: 0.7s;
}

/* Nav bar items */
.hero-nav-item {
  background: transparent;
  color: rgba(255,255,255,0.85);
  transition: background 0.2s ease, color 0.2s ease;
}
.hero-nav-item:hover {
  background: rgba(255,255,255,0.05);
  color: #FE9834;
}
.hero-nav-item.is-active {
  background: rgba(255,255,255,0.12);
  color: #FE9834;
  font-weight: 700;
}
</style>

<script is:inline>
(function () {
  function initHeroSlider() {
    const container = document.getElementById('hero-slider-container');
    if (!container) return;

    const bgItems      = container.querySelectorAll('.hero-bg-item');
    const contentItems = container.querySelectorAll('.hero-content-item');
    const dots         = container.querySelectorAll('.hero-dot');
    const navItems     = container.querySelectorAll('.hero-nav-item');

    let currentIndex = 0;
    const totalSlides = bgItems.length;
    let autoPlayTimer = null;
    const navToSlideMap = { 0: 1, 1: 0, 2: 2, 3: 3 };

    function goToSlide(newIndex) {
      if (newIndex === currentIndex) return;
      const prevIndex = currentIndex;

      bgItems[prevIndex].classList.remove('is-active');
      bgItems[prevIndex].classList.add('is-leaving');
      bgItems[newIndex].classList.remove('is-leaving');
      bgItems[newIndex].classList.add('is-active');

      setTimeout(() => {
        bgItems[prevIndex].classList.remove('is-leaving');
      }, 700);

      contentItems[prevIndex].classList.remove('is-active');
      contentItems[prevIndex].querySelectorAll('.hero-el').forEach(el => {
        el.style.cssText = 'opacity:0;transform:translateY(22px);transition:none';
      });
      contentItems[newIndex].classList.add('is-active');
      contentItems[newIndex].querySelectorAll('.hero-el').forEach(el => {
        el.style.cssText = '';
      });

      dots.forEach((dot, idx) => {
        if (idx === newIndex) {
          dot.className = 'hero-dot cursor-pointer rounded-full transition-all duration-300 h-3 w-3 border-2 border-brand bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-black';
        } else {
          dot.className = 'hero-dot cursor-pointer rounded-full transition-all duration-300 h-2 w-2 bg-white/40 hover:bg-white/70';
        }
      });

      navItems.forEach((nav, navIdx) => {
        if (navToSlideMap[navIdx] === newIndex) {
          nav.classList.add('is-active', 'bg-white/12', 'text-[#FE9834]', 'font-bold');
        } else {
          nav.classList.remove('is-active', 'bg-white/12', 'text-[#FE9834]', 'font-bold');
        }
      });

      currentIndex = newIndex;
    }

    function next() { goToSlide((currentIndex + 1) % totalSlides); }
    function startAuto() { stopAuto(); autoPlayTimer = setInterval(next, 5500); }
    function stopAuto()  { clearInterval(autoPlayTimer); }

    let tx0 = 0;
    container.addEventListener('touchstart', e => { tx0 = e.touches[0].clientX; }, { passive: true });
    container.addEventListener('touchend', e => {
      const diff = tx0 - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        goToSlide(diff > 0 ? (currentIndex + 1) % totalSlides : (currentIndex - 1 + totalSlides) % totalSlides);
        startAuto();
      }
    });

    dots.forEach(dot => dot.addEventListener('click', () => {
      goToSlide(parseInt(dot.dataset.index)); startAuto();
    }));

    navItems.forEach(nav => nav.addEventListener('click', () => {
      const si = navToSlideMap[parseInt(nav.dataset.navIndex)];
      if (si !== undefined) { goToSlide(si); startAuto(); }
    }));

    container.addEventListener('mouseenter', stopAuto);
    container.addEventListener('mouseleave', startAuto);

    startAuto();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
})();
</script>

  <!-- About -->
  <section class="section">
    <div class="wrap grid items-center gap-[60px] lg:grid-cols-2">
      <div>
        <span class="badge">About TPC Cargo</span>
        <h2 class="heading"><span class="text-[#FE7E01]">Cyprus Cargo,</span><br />Globally Connected.</h2>
        <p class="text-muted mt-6"><strong>TPC Cargo service part of TPC EXPRESS LTD</strong>, enables Cyprus cargo access to strategic regions, countries and markets. Combining our knowledge with a superior customer service skills, and together with a network of key port terminals, road/rail access routes, warehousing and our trusted worldwide partners – we promise reliability and the highest level of professional services, at the most competitive rates.</p>
        <p class="text-muted mt-5"><strong>Founded in 2015 in Cyprus</strong>, the vast experience we collect over the years in the transportation industry served as the best input for building and establishing <strong>TPC Cargo</strong> as a major regional and global cargo logistics provider.</p>
      </div>
      <div class="relative group cursor-pointer" id="video-play-trigger">
        <img src="/images/about-team.jpg" alt="TPC Cargo team" class="aspect-[3/2] w-full rounded-2xl object-cover shadow-md transition-transform duration-500 group-hover:scale-[1.01]" />
        
        <!-- Play Button Overlay matching screenshot -->
        <div class="absolute inset-0 flex items-center justify-center z-10">
          <button
            aria-label="Play video"
            class="relative flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white shadow-xl transition-all duration-300 group-hover:scale-110 cursor-pointer"
          >
            <!-- Pulsing Ripple Animation -->
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-60"></span>
            
            <!-- Play Icon -->
            <svg class="relative h-10 w-10 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>

        <!-- 10+ Years Experience Badge -->
        <div class="absolute -bottom-5 -left-2 md:-left-4 rounded-lg md:rounded-xl bg-brand px-4 md:px-6 py-2 md:py-4 text-white z-20">
          <div class="text-2xl font-semibold"><span id="exp-counter">0</span>+</div>
          <div class="text-xs font-medium">Years of Experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Lightbox Popup Modal -->
  <div
    id="video-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="TPC Cargo Video"
  >
    <div class="relative w-full max-w-4xl aspect-video rounded-2xl overflow-hidden bg-black shadow-2xl scale-95 transition-transform duration-300" id="video-modal-content">
      <!-- Close Button -->
      <button
        id="video-modal-close"
        aria-label="Close video modal"
        class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/70 text-white hover:bg-brand transition-colors cursor-pointer"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Video iFrame -->
      <iframe
        id="video-iframe"
        class="w-full h-full border-0"
        src=""
        data-src="https://www.youtube-nocookie.com/embed/3JZ_D3ELwOQ?autoplay=1&enablejsapi=1"
        title="TPC Cargo Video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>

  <script is:inline>
    function initVideoModal() {
      const trigger = document.getElementById('video-play-trigger');
      const modal = document.getElementById('video-modal');
      const modalContent = document.getElementById('video-modal-content');
      const closeBtn = document.getElementById('video-modal-close');
      const iframe = document.getElementById('video-iframe');

      if (!trigger || !modal || !iframe) return;

      function openModal() {
        const videoSrc = iframe.getAttribute('data-src');
        if (videoSrc) iframe.src = videoSrc;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        if (modalContent) {
          modalContent.classList.remove('scale-95');
          modalContent.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        iframe.src = '';
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        if (modalContent) {
          modalContent.classList.remove('scale-100');
          modalContent.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      trigger.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);

      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoModal);
    } else {
      initVideoModal();
    }
  </script>

  <script is:inline>
    (function () {
      var el = document.getElementById('exp-counter');
      if (!el) return;
      var target = 10, duration = 1500, started = false;

      function runCounter() {
        if (started) return;
        started = true;
        var start = null;
        function step(ts) {
          if (!start) start = ts;
          var progress = Math.min((ts - start) / duration, 1);
          // ease-out
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = target;
        }
        requestAnimationFrame(step);
      }

      var observer = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) { runCounter(); observer.disconnect(); }
      }, { threshold: 0.5 });

      observer.observe(el);
    })();
  </script>

  <Stats />

  <!-- Beyond shipping (dark) -->
  <section class="section relative mt-14 bg-dark text-white md:mt-20 overflow-hidden py-16">
    <div class="wrap relative">
      <!-- Header row -->
      <div class="grid gap-4 lg:grid-cols-2 md:items-center mb-10">
        <SectionHeading light badge="Beyond the ordinary" title="More Than Shipping, [Complete Logistics Support.]" />
        <p class="text-lg leading-[30px] text-[#9D9C9B]">Experience the best in international transport with our special services. From cargo shipments to customs clearance, our team is ready to meet all your needs.</p>
      </div>

      <!-- Slider Container Layout: Left Dots Outside + Slider Track -->
      <div class="relative">
        <!-- Desktop Left Vertical Dots Outside Container -->
        <div class="hidden lg:flex flex-col justify-center gap-3.5 shrink-0 z-30 absolute -left-7 lg:-left-9 xl:-left-[14%] top-1/2 -translate-y-1/2" id="beyond-slider-dots-desktop">
          <button data-index="0" aria-label="Slide 1" class="slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer"></button>
          <button data-index="1" aria-label="Slide 2" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
          <button data-index="2" aria-label="Slide 3" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
          <button data-index="3" aria-label="Slide 4" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        </div>

        <!-- Slider Track Wrapper Aligned with Container -->
        <div class="w-full [clip-path:none] lg:[clip-path:inset(-20px_-2000px_-20px_0px)]">
          <div class="swiper beyond-swiper !overflow-visible select-none">
            <div class="swiper-wrapper">
              {beyond.map((s) => (
                <div class="swiper-slide !h-auto">
                  <ServiceCard service={s} dark />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile / Tablet Bottom Horizontal Dots -->
      <div class="flex lg:hidden justify-center items-center gap-3.5 mt-8 z-20" id="beyond-slider-dots-mobile">
        <button data-index="0" aria-label="Slide 1" class="slider-dot active h-2.5 w-2.5 rounded-full bg-brand ring-2 ring-brand/40 ring-offset-2 ring-offset-[#120d09] transition-all cursor-pointer"></button>
        <button data-index="1" aria-label="Slide 2" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        <button data-index="2" aria-label="Slide 3" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
        <button data-index="3" aria-label="Slide 4" class="slider-dot h-2 w-2 rounded-full bg-gray-600 hover:bg-gray-400 transition-all cursor-pointer"></button>
      </div>
    </div>
  </section>

