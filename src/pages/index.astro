  },
  {
    name: 'Warehousing',
    href: '/services/packaging-and-storage',
    svg: `<svg width="43" height="43" viewBox="0 0 43 43" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_wh)"><path d="M10.1176 31.6176H32.8824V36.0441H10.1176V31.6176ZM10.1176 29.0882V24.6617H32.8824V29.0882H10.1176ZM10.1176 38.5735H32.8824V43H10.1176V38.5735ZM35.4118 43V23.397C35.4118 23.0616 35.2785 22.7399 35.0413 22.5028C34.8042 22.2656 34.4825 22.1323 34.1471 22.1323H8.85294C8.51752 22.1323 8.19584 22.2656 7.95866 22.5028C7.72148 22.7399 7.58824 23.0616 7.58824 23.397V43H3.79412C2.78786 43 1.82281 42.6002 1.11127 41.8887C0.399736 41.1772 0 40.2121 0 39.2059L0 15.3137C-1.51769e-06 14.6702 0.163668 14.0372 0.475618 13.4744C0.787567 12.9116 1.23755 12.4373 1.78324 12.0963L19.4891 1.03008C20.0921 0.653204 20.7889 0.453369 21.5 0.453369C22.2111 0.453369 22.9079 0.653204 23.5109 1.03008L41.2168 12.0963C41.7625 12.4373 42.2124 12.9116 42.5244 13.4744C42.8363 14.0372 43 14.6702 43 15.3137V39.2059C43 40.2121 42.6003 41.1772 41.8887 41.8887C41.1772 42.6002 40.2121 43 39.2059 43H35.4118ZM17.7059 16.4412H25.2941C25.6295 16.4412 25.9512 16.3079 26.1884 16.0707C26.4256 15.8336 26.5588 15.5119 26.5588 15.1765C26.5588 14.841 26.4256 14.5193 26.1884 14.2822C25.9512 14.045 25.6295 13.9117 25.2941 13.9117H17.7059C17.3705 13.9117 17.0488 14.045 16.8116 14.2822C16.5744 14.5193 16.4412 14.841 16.4412 15.1765C16.4412 15.5119 16.5744 15.8336 16.8116 16.0707C17.0488 16.3079 17.3705 16.4412 17.7059 16.4412Z" fill="currentColor"/></g><defs><clipPath id="clip0_wh"><rect width="43" height="43" fill="white"/></clipPath></defs></svg>`,
