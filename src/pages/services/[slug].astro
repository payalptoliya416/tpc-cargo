---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Stats from '../../components/Stats.astro';
import Testimonials from '../../components/Testimonials.astro';
import Faq from '../../components/Faq.astro';
import WhyUs from '../../components/WhyUs.astro';
import MoreServices from '../../components/MoreServices.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { serviceImages } from '../../data/images';

// One page is created for every service in data/services.ts
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const img = serviceImages[service.slug];

// Helper to bold prefixes like "FCL/Full Container", "LCL/...", etc.
function formatCapParagraph(p: string) {
  const commaIndex = p.indexOf(',');
  if (commaIndex !== -1 && (p.startsWith('FCL') || p.startsWith('LCL') || p.startsWith('RORO') || p.startsWith('BULK'))) {
    const title = p.substring(0, commaIndex);
    const rest = p.substring(commaIndex);
    return `<strong class="font-bold text-gray-900">${title}</strong>${rest}`;
  }
  return p;
}

// Every service gets these 2 extra FAQs at the end
const faqs = [
  ...service.faqs,
  [`What Information Is Needed For A ${service.name} Quote?`, 'The type of cargo, its size and weight, where it is going from and to, and when you need it delivered.'],
  [`How Can I Request A ${service.name} Quote?`, 'Fill in the quote form on this page or email info@tpccargo.com and our team will get back to you.'],
];
---
<Layout title={`${service.name} | TPC Cargo`}>
  <ServiceHero
    badge={service.heroBadge}
    title={service.heroTitle}
    text={service.heroText}
    image={img.hero}
    formTitle={`Get Your ${service.name} Quote`}
  />

  <!-- Capabilities Section -->
  <section class="section">
    <div class="wrap space-y-10">
      <!-- Header Row: Title & Badge on Left, Intro Text on Right -->
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-14 lg:items-end">
        <div>
          <span class="badge">Our {service.name} capabilities</span>
          <h2 class="heading mt-4">Discover Our <span class="text-brand">Capabilities<br class="hidden sm:inline" /> And Network</span></h2>
        </div>
        {service.capParagraphs[0] && (
          <p class="text-sm sm:text-base leading-relaxed text-gray-500">
            {service.capParagraphs[0]}
          </p>
        )}
      </div>

      <!-- Staggered 2x2 Matrix -->
      {img.cap.length >= 2 ? (
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-7 items-start">
          <!-- Left Column: Paragraphs 1 & 2, then Image 1 -->
          <div class="flex flex-col gap-8">
            <div class="space-y-5 text-sm sm:text-base leading-relaxed text-gray-500">
              {service.capParagraphs.slice(1, 3).map((p) => (
                <p set:html={formatCapParagraph(p)} />
              ))}
            </div>

            <img
              src={img.cap[0]}
              alt={`${service.name} cap 1`}
              class="w-full object-cover shadow-sm"
              loading="lazy"
            />
          </div>

          <!-- Right Column: Image 2, then Paragraphs 3 & 4 -->
          <div class="flex flex-col gap-8">
            <img
              src={img.cap[1]}
              alt={`${service.name} cap 2`}
              class="w-full object-cover shadow-sm"
              loading="lazy"
            />

            <div class="space-y-5 text-sm sm:text-base leading-relaxed text-gray-500">
              {service.capParagraphs.slice(3).map((p) => (
                <p set:html={formatCapParagraph(p)} />
              ))}
            </div>

            {service.bullets && (
              <ul class="space-y-2.5 pt-2">
                {service.bullets.map((b) => (
                  <li class="flex items-center gap-3 text-sm font-medium text-gray-700">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand/15 text-brand">
                      <Icon name="check" class="h-3 w-3" />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ) : (
        /* Single Image Layout fallback for other services */
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 items-start">
          <div class="space-y-5 text-sm sm:text-base leading-relaxed text-gray-500">
            {service.capParagraphs.slice(1).map((p) => (
              <p set:html={formatCapParagraph(p)} />
            ))}
            {service.bullets && (
              <ul class="space-y-2.5 pt-2">
                {service.bullets.map((b) => (
                  <li class="flex items-center gap-3 text-sm font-medium text-gray-700">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand/15 text-brand">
                      <Icon name="check" class="h-3 w-3" />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <div>
            <img
              src={img.cap[0]}
              alt={service.name}
              class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
              loading="lazy"
            />
          </div>
        </div>
      )}
    </div>
  </section>

  <Stats />

  <!-- Solutions: image touches the screen edge, text lines up with the container -->
  <section class="mt-14 grid bg-cream md:mt-20 lg:grid-cols-2">
    <div class:list={['flex flex-col justify-center px-4 py-14 md:px-8 lg:py-20', img.solLeft ? 'lg:order-2 lg:pr-[max(3rem,calc((100vw-1440px)/2))] lg:pl-16' : 'lg:pl-[max(3rem,calc((100vw-1440px)/2))] lg:pr-16']}>
      <SectionHeading badge={`Our ${service.name} solutions`} title={service.solTitle} />
      <div class="mt-5 space-y-4">
        {service.solParagraphs.map((p) => <p class="text-muted">{p}</p>)}
      </div>
      <div><a href="/contacts" class="btn mt-8 !text-black">Contact Now</a></div>
    </div>
    <img src={img.sol} alt={service.name} class:list={['h-72 w-full object-cover lg:h-full', img.solLeft && 'lg:order-1']} loading="lazy" />
  </section>

  <Testimonials />
  <Faq badge={`${service.name} FAQ`} title={`Questions About [${service.name}]?`} intro={service.faqIntro} faqs={faqs} />
  <WhyUs />
  <MoreServices current={service.slug} />
  <CtaBanner badge="Ready to move your cargo?" title={`Let’s Plan Your [${service.name}] Shipment`} text="Tell us your route and cargo requirements and our team will help you find the right shipping solution." button="Get a free quote" image={img?.cta || img?.sol} />
</Layout>
