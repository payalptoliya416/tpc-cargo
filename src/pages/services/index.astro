---
import Layout from '../../layouts/Layout.astro';
import PageBanner from '../../components/PageBanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WhyUs from '../../components/WhyUs.astro';
import { services } from '../../data/services';
---
<Layout title="Services | TPC Cargo">
  <!-- Top Hero Banner -->
  <PageBanner title="Services" image="/images/services.png" />

  <!-- Section 1: Our Logistics Services Grid -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-4 lg:grid-cols-2 md:items-center mb-10">
        <div>
          <span class="badge">Our Services</span>
          <h2 class="heading">Our Logistics <span class="text-[#FE7E01]">Services</span></h2>
        </div>
        <p class=" text-muted text-[#858482] font-medium">
          Thru our logistics network and together with our experience, customer service, and tailor made solutions – you will benefit from the best routes and price you deserve.
        </p>
      </div>

      <div class="grid gap-5 md:gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- Section 2: Split 2-Column Section (Effective Solutions & A Wealth of Experience) -->
  <section class="grid grid-cols-1 lg:grid-cols-2 overflow-hidden">
    <!-- Left Column: Light Grey Background -->
    <div class="bg-[#f2f4f7] py-10 sm:py-20 md:py-24 px-6 sm:px-10 md:px-16 lg:px-20 flex lg:justify-end">
      <div class="w-full max-w-[700px] space-y-4 md:space-y-5">
        <div class="badge">
          <span>Our Approach</span>
        </div>
        <h2 class="text-3xl font-medium leading-tight sm:text-4xl md:text-5xl text-dark">
          <span class="text-[#FE7E01]">Effective</span> Solutions
        </h2>
        <p class="text-base leading-relaxed text-[#858482] sm:text-lg md:leading-8">
          You benefit from our experience in delivering effective solutions to the complex global supply chains of some of the world's biggest corporations. You benefit from many innovation, whether it involves a simple standard Sea or Air Cargo Freight products, Multimodal solutions, whether it involves a investment in warehousing, or whether it requires a completely new integrated supply chain model.
        </p>
      </div>
    </div>

    <!-- Right Column: Light Cream Background -->
    <div class="bg-[#fff9f4] py-14 sm:py-20 md:py-24 px-6 sm:px-10 md:px-16 lg:px-20 flex lg:justify-start">
      <div class="w-full max-w-[700px] space-y-4 md:space-y-5">
        <div class="badge">
          <span>Our Heritage</span>
        </div>
        <h2 class="text-3xl font-medium leading-tight sm:text-4xl md:text-5xl text-dark">
          A Wealth of <span class="text-[#FE7E01]">Experience</span>
        </h2>
        <p class="text-base leading-relaxed text-[#858482] sm:text-lg md:leading-8">
          Every new solution adds to the wealth of our experience, and deepens our competence and capability. All of which is the reason why you will find that at TPC Cargo we try to apply that proven innovation to support all your business.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Dark 3-Feature Bar -->
  <WhyUs middle="Innovation" />
</Layout>
